# Backend. Copy to HEALTHCARE/.env and fill in locally.
PORT=4000
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Optional Google Gemini key for the AI Doctor feature; this is not a Supabase key.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional. The default model is gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
